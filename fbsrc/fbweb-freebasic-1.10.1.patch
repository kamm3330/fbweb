diff -ruN a/src/rtlib/unix/hinit.c b/src/rtlib/unix/hinit.c
--- a/src/rtlib/unix/hinit.c	2026-11-13 20:47:56.039531485 +0100
+++ b/src/rtlib/unix/hinit.c	2026-11-13 20:47:56.043531522 +0100
@@ -121,6 +121,18 @@
    extended to support more). */
 static int fb_hTermQuery( int code, int *val1, int *val2 )
 {
+	/* FBWeb: the browser console is driven by FB itself, so FB's own cursor
+	   bookkeeping is exact.  Querying the terminal would mix the reply with
+	   fast typed / pasted input (stdio buffering in getchar/scanf vs. raw
+	   reads elsewhere), which can lose keys or hang.  Skip the query. */
+	static int fbweb = -1;
+	if( fbweb < 0 ) {
+		const char *e = getenv( "FBWEB_CONSOLE" );
+		fbweb = (e && *e && *e != '0');
+	}
+	if( fbweb )
+		return FALSE;
+
 	if( fb_hTermOut( code, 0, 0 ) == FALSE )
 		return FALSE;
 
@@ -382,6 +394,11 @@
 		__fb_con.f_in = fopen("/dev/tty", "r+b");
 		if (!__fb_con.f_in)
 			return -1;
+		/* Unbuffered: otherwise fgetc() may pull several typed/pasted keys
+		   into the stdio buffer, while key availability is later checked on
+		   the raw file descriptor -> keys appear "stuck" until the next key
+		   press.  (Found while building FBWeb.) */
+		setvbuf(__fb_con.f_in, NULL, _IONBF, 0);
 		__fb_con.h_in = fileno(__fb_con.f_in);
 	}
 	
diff -ruN a/src/rtlib/unix/io_inkey.c b/src/rtlib/unix/io_inkey.c
--- a/src/rtlib/unix/io_inkey.c	2026-11-13 20:47:56.043531522 +0100
+++ b/src/rtlib/unix/io_inkey.c	2026-11-13 20:47:56.043531522 +0100
@@ -281,7 +281,11 @@
 		return feof(stdin) ? FALSE : TRUE;
 
 	fb_hGetCh(FALSE);
-	result = key_buffer_changed;
+	/* Also report keys that are still waiting in the buffer: with fast typed
+	   or pasted input several keys can be buffered at once, and only checking
+	   key_buffer_changed left them stuck until the next key press.
+	   (Fix made for FBWeb.) */
+	result = key_buffer_changed || (key_head != key_tail);
 	key_buffer_changed = FALSE;
 	return result;
 }
